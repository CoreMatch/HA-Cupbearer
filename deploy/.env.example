# 复制为 .env 后按实际环境修改。所有值都会通过 envsubst 注入各服务的
# YAML 配置模板 (config/*.yaml.tmpl)。
#
#   cp .env.example .env && 编辑 .env
#   docker compose up -d            # 默认：拉取已发布镜像（digest 钉死）
#
# 本地构建是显式可选路径（无网络/改代码验证时），不在默认步骤内:
#   docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build

# ---------- 版本与时区 ----------
# VERSION 仅本地构建形态（docker-compose.build.yml）用作本地 tag；
# 默认形态拉取已发布镜像，不使用该值。
VERSION=latest
TZ=Asia/Shanghai

# ---------- 外部 MySQL (不在编排内启动) ----------
# DB_HOST 只填主机名/IP，不要自带端口：HRPAuth (v12+)、Yggdrasil-API (v4+)
# 与 HASkinLib (v7+) 已有独立端口字段，模板渲染 host="${DB_HOST}" + port=${DB_PORT}；
# 旧版本代码（无端口字段）也兼容——其 DSN 会直接使用 host。
DB_HOST=10.0.0.10
DB_PORT=3306
DB_USER=hrpa
DB_PASSWORD=change-me
DB_NAME=hrpa
# 各服务独占数据库：四家（HRPAuth/YGG/HASkinLib/MCA）的 schema_migrations
# 簿记表结构互不兼容，共库必互踩。各库需预建（字符集 utf8mb4）。
HRPAUTH_DB_NAME=hrpa
YGG_DB_NAME=ygg
HASKINLIB_DB_NAME=haskinlib
MCA_DB_NAME=matchcorearena

# ---------- 外部 Redis (不在编排内启动) ----------
REDIS_HOST=10.0.0.11
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 对外访问地址 ----------
HRPAUTH_PUBLIC_URL=https://ha.example.com
HRPAUTH_FRONTEND_URL=https://auth.example.com
YGG_PUBLIC_URL=https://ha.example.com/yggdrasil-api
HASKINPROXY_PUBLIC_URL=https://skin-proxy.example.com
WINNERPROXY_PUBLIC_URL=https://winner-proxy.example.com
MAINTENANCEVIEW_PUBLIC_URL=https://maintenance.example.com

# ---------- OAuth / 内部客户端 ----------
MANAGE_TOKEN=change-me
HRPAUTH_PUBLIC_CLIENT_ID=hrpauth-webui
# HRPAuth 内置 super client 凭据：HRPAuth 自身 oauth2 段使用，同时注入
# MatchCoreArena-Server 作为服务身份（auth.hrpauth.service_client_id/secret，
# config 1.5.0）。两处必须同值；MCA 侧缺值会直接启动失败。
# MCA 维持共用 super client，不新增专用客户端（作者口径：开发环境共用即可）。
# 三个卫星服务（WinnerProxy / YGG / HASkinProxy）不默认注入 super 凭据；
# 如需走懒人路径，把下方对应服务的变量填成这里的 super 值即可（见下方注释）。
HRPAUTH_SUPER_CLIENT_ID=hrpauth-internal-super
HRPAUTH_SUPER_CLIENT_SECRET=change-me
# 四个卫星服务 + HASkinLib 的专用客户端凭据（必填，缺值时 compose 直接报错；
# HASkinLib 一对同时种入 HRPAuth oauth2.service_clients，见 hrpauth.yaml.tmpl）：
# HRPAuth v13 起由 oauth2.service_clients 在启动时幂等登记到
# oauth2_clients（confidential / client_credentials / is_super=false）。
# 命名约定：种子 client_id 与各服务 presence 自报名逐字一致（WinnerProxy /
# HRPAuth-Yggdrasil-API / HASkinProxy；SDKHandler 无 presence、不走自助，
# 保持原名）——因此 v14 自助注册的懒人路径（get-or-create）直接命中原种子行，
# 不会新建第二行。
# 旧名行（winnerproxy / hrpauth-yggdrasil-api / yggdrasil-api / haskinproxy）
# 不会自动改名，升级时需人工清掉开发库里的旧行或忽略（不做自动迁移）。
#
# WinnerProxy / YGG / HASkinProxy 三对变量：填什么就按什么，运行时由服务
# 自己判断（三选一，缺值/留空则 compose 直接报错、启动失败）：
#   1) 填 super 凭据（HRPAUTH_SUPER_CLIENT_ID/SECRET 的值）→ 启动时经
#      POST /oauth/register 自动换取本服务低权限客户端（懒人路径；
#      client_id = presence 名；容器内配置写回不持久化，每次启动重新换取，
#      拿到的 secret 稳定，无副作用）；
#   2) 填该服务自己的专用低权限对（下方默认值，即 HRPAuth 种子预置的行）→
#      启动校验通过后直接使用（幂等路径，不发换取请求）；
#   3) 留空 → 启动失败并明确报错。
# 一致性前提：若把 super secret 填进某个服务的变量，HRPAuth 种子机制会看到
# "该条目的 secret 等于 super secret"，从而跳过该种子条目并告警（防呆，
# 避免把 super secret 复制成普通客户端行）；该服务随后走自助注册拿到独立
# secret。若发现"种子里没建出这行"，原因即此，不必困惑。
# SDKHandler 一对：变量直接注入它自己的配置，单一来源。
YGG_CLIENT_ID=HRPAuth-Yggdrasil-API
YGG_CLIENT_SECRET=change-me
HASKINPROXY_CLIENT_ID=HASkinProxy
HASKINPROXY_CLIENT_SECRET=change-me
WINNERPROXY_CLIENT_ID=WinnerProxy
WINNERPROXY_CLIENT_SECRET=change-me
SDKHANDLER_CLIENT_ID=hrpauth-webui-sdkhandler
SDKHANDLER_CLIENT_SECRET=change-me
# HASkinLib 一对：与 SDKHandler 同模式（无 presence、不走自助换取，变量直接
# 注入它自己的 core_api 段，单一来源）。client_id 固定 haskinlib——HRPAuth
# 启动时幂等种入的第 5 条服务客户端种子；SECRET 必须填 HRPAuth 渲染配置中该
# 种子行的 secret（种子 secret 由 HRPAuth 首次启动生成并持久化）。
# 留空/缺值：compose 直接报错（:? 防呆），不会退化为无鉴权调用（运行时 401）。
HASKINLIB_CLIENT_ID=haskinlib
HASKINLIB_CLIENT_SECRET=change-me
# Internal Key：访问 SDKHandler /api/* 时携带的 X-Internal-Key（作者 2026-11-05
# 决定：主程序不调用 SDKHandler，该密钥保护的是本地运维脚本与任何非授权访问）。
# 留空 = fail-closed（/api/* 全部 401）。
SDKHANDLER_INTERNAL_KEY=change-me
# MatchCoreArena-Server 运维超级凭据（auth.maintenance_token，v1.4.0 配置项）。
MCA_MAINTENANCE_TOKEN=change-me
# 成局后下发给客户端的游戏服务器地址（config 1.8.0 matchmaking.join_target）。
# 留空 host（默认）表示未配置：成局响应不携带 join_target，客户端回落本地配置。
# 承接真实对局时填游戏服地址，例如 MCA_JOIN_TARGET_HOST=mc.example.com、
# MCA_JOIN_TARGET_PORT=25565。配置了 host 时 port 必须为 1-65535。
MCA_JOIN_TARGET_HOST=
MCA_JOIN_TARGET_PORT=0

# ---------- 端口绑定（暴露面控制） ----------
# 内部服务默认只绑回环；确需远程访问再改对应 *_BIND 并配置防火墙。
# 游戏/用户直接访问的服务（HRPAuth、YGG、SkinLib、SkinProxy、WinnerProxy、MCA）
# 保持默认全网卡监听。
SDKHANDLER_BIND=127.0.0.1
DEPLOYER_BIND=127.0.0.1
MAINTENANCEVIEW_BIND=127.0.0.1
# 可选端口覆盖：compose 对这些变量全部使用 ${VAR:-默认值}，不改即取下方
# 与 compose 一致的默认值；仅当端口冲突等需要时才修改。
HRPAUTH_PORT=2778
YGG_PORT=2770
HASKINLIB_PORT=2701
HASKINPROXY_PORT=2702
WINNERPROXY_PORT=2777
MCA_SERVER_PORT=9178
SDKHANDLER_PORT=2704
SDKHANDLER_MAINTENANCE_PORT=2705
DEPLOYER_PORT=18080
MAINTENANCEVIEW_PORT=18081
# 可选的 WebUI 静态托管（docker compose --profile webui up -d）：
# 对外前端入口，默认全网卡；仅内网使用时改 WEBUI_BIND=127.0.0.1。
WEBUI_PORT=8080
WEBUI_BIND=0.0.0.0

# ---------- HA-WebUI-SDKHandler 前端模板来源 ----------
# 留空 = 默认克隆到可写卷 /app/template-src（compose 已设此默认值，自动从
# SDKHANDLER_TEMPLATE_GIT_URL 拉取）。若要用预置模板：把内容放进
# ./sdkhandler-template/（只读挂载到 /app/template），并设
# SDKHANDLER_TEMPLATE_DIR=/app/template。
SDKHANDLER_TEMPLATE_DIR=
SDKHANDLER_TEMPLATE_GIT_URL=https://github.com/CoreMatch/HRPAuth-WebUI.git

# ---------- SMTP ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# ---------- 签名密钥目录 (挂载 ./deploy/secrets) ----------
# 需要把 private_key.pem / public_key.pem 放到 deploy/secrets/ 下。
SIGNATURE_KEY_DIR=/app/secrets
