# 复制为 .env 后按实际环境修改。所有值都会通过 envsubst 注入各服务的
# YAML 配置模板 (config/*.yaml.tmpl)。
#
#   cp .env.example .env && 编辑 .env
#   docker compose up -d --build
#
# 编排文件在 deploy/ 目录, 构建上下文指向同级的各个仓库 (../HRPAuth 等)。

# ---------- 版本与时区 ----------
VERSION=latest
TZ=Asia/Shanghai

# ---------- 外部 MySQL (不在编排内启动) ----------
# DB_HOST 只填主机名/IP，不要自带端口：HRPAuth (v12+)、Yggdrasil-API (v4+)
# 与 HASkinLib (v7+) 已有独立端口字段，模板渲染 host="${DB_HOST}" + port=${DB_PORT}；
# 旧版本代码（无端口字段）也兼容——其 DSN 会直接使用 host。
DB_HOST=10.0.0.10
DB_PORT=3306
DB_USER=hrpa
DB_PASSWORD=change-me
DB_NAME=hrpa

# ---------- 外部 Redis (不在编排内启动) ----------
REDIS_HOST=10.0.0.11
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 对外访问地址 ----------
HRPAUTH_PUBLIC_URL=https://ha.example.com
HRPAUTH_FRONTEND_URL=https://auth.example.com
YGG_PUBLIC_URL=https://ha.example.com/yggdrasil-api
HASKINPROXY_PUBLIC_URL=https://skin-proxy.example.com
WINNERPROXY_PUBLIC_URL=https://winner-proxy.example.com
MAINTENANCEVIEW_PUBLIC_URL=https://maintenance.example.com

# ---------- OAuth / 内部客户端 ----------
MANAGE_TOKEN=change-me
HRPAUTH_PUBLIC_CLIENT_ID=hrpauth-webui
HRPAUTH_SUPER_CLIENT_ID=hrpauth-internal-super
HRPAUTH_SUPER_CLIENT_SECRET=change-me
YGG_CLIENT_ID=hrpauth-yggdrasil-api
YGG_CLIENT_SECRET=change-me
HASKINPROXY_CLIENT_ID=haskinproxy
HASKINPROXY_CLIENT_SECRET=change-me
WINNERPROXY_CLIENT_ID=winnerproxy
WINNERPROXY_CLIENT_SECRET=change-me
SDKHANDLER_CLIENT_ID=hrpauth-webui-sdkhandler
SDKHANDLER_CLIENT_SECRET=change-me
# Internal Key：访问 SDKHandler /api/* 时携带的 X-Internal-Key（作者 2026-11-05
# 决定：主程序不调用 SDKHandler，该密钥保护的是本地运维脚本与任何非授权访问）。
# 留空 = fail-closed（/api/* 全部 401）。
SDKHANDLER_INTERNAL_KEY=change-me
# MatchCoreArena-Server 运维超级凭据（auth.maintenance_token，v1.4.0 配置项）。
MCA_MAINTENANCE_TOKEN=change-me

# ---------- 端口绑定（暴露面控制） ----------
# 内部服务默认只绑回环；确需远程访问再改对应 *_BIND 并配置防火墙。
# 游戏/用户直接访问的服务（HRPAuth、YGG、SkinLib、SkinProxy、WinnerProxy、MCA）
# 保持默认全网卡监听。
SDKHANDLER_BIND=127.0.0.1
DEPLOYER_BIND=127.0.0.1
MAINTENANCEVIEW_BIND=127.0.0.1
# 可选的 WebUI 静态托管（docker compose --profile webui up -d）：
# 对外前端入口，默认全网卡；仅内网使用时改 WEBUI_BIND=127.0.0.1。
WEBUI_PORT=8080
WEBUI_BIND=0.0.0.0

# ---------- HA-WebUI-SDKHandler 前端模板来源 ----------
# 留空 = 默认克隆到可写卷 /app/template-src（compose 已设此默认值，自动从
# SDKHANDLER_TEMPLATE_GIT_URL 拉取）。若要用预置模板：把内容放进
# ./sdkhandler-template/（只读挂载到 /app/template），并设
# SDKHANDLER_TEMPLATE_DIR=/app/template。
SDKHANDLER_TEMPLATE_DIR=
SDKHANDLER_TEMPLATE_GIT_URL=https://github.com/CoreMatch/HRPAuth-WebUI.git

# ---------- SMTP ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# ---------- 签名密钥目录 (挂载 ./deploy/secrets) ----------
# 需要把 private_key.pem / public_key.pem 放到 deploy/secrets/ 下。
SIGNATURE_KEY_DIR=/app/secrets
