server:
    listen_addr: ":2702"
    public_url: "${HASKINPROXY_PUBLIC_URL}"

upstream:
    base_url: "${HRPAUTH_URL}"
    timeout: 10
    # v14 凭据语义（填什么就按什么，运行时由服务自己判断，详见 .env.example）：
    # 填 super 凭据 → 启动时经 POST /oauth/register 换取本服务低权限客户端
    # （client_id = presence 名 HASkinProxy）；填专用低权限对 → 幂等校验、不换取。
    # 容器内配置写回不持久化，换取路径下每次启动重新换取，secret 稳定。
    # 若填 super secret，HRPAuth 种子会跳过本服务种子条目并告警。
    client_id: "${HASKINPROXY_CLIENT_ID}"
    client_secret: "${HASKINPROXY_CLIENT_SECRET}"

cache:
    profile_ttl: 3600
    texture_ttl: 86400
    max_size_mb: 256

presence:
    enabled: true
    name: HASkinProxy
    # 0 = 记录永不过期（代码默认语义，显式写出）。
    ttl_seconds: 0

sdk:
    enabled: true
