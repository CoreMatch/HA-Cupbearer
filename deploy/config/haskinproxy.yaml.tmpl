server:
    listen_addr: ":2702"
    public_url: "${HASKINPROXY_PUBLIC_URL}"

upstream:
    base_url: "${HRPAUTH_URL}"
    timeout: 10
    # v14 凭据语义（两种用法，详见 .env.example）：当前 compose 默认注入
    # super 凭据，启动时经 POST /oauth/register 换取本服务低权限客户端
    # （client_id = presence 名 HASkinProxy）；填低权限配对则幂等校验、不换取。
    # 容器内配置写回不持久化，每次启动重新换取，secret 稳定。
    client_id: "${HASKINPROXY_CLIENT_ID}"
    client_secret: "${HASKINPROXY_CLIENT_SECRET}"

cache:
    profile_ttl: 3600
    texture_ttl: 86400
    max_size_mb: 256

presence:
    enabled: true
    name: HASkinProxy

sdk:
    enabled: true
