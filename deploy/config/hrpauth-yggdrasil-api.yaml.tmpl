# version 4 = v3 + database.port（YGG 配置 v4）。历史上短暂存在过的
# "v4 = manage.token" 已在上游回退（force-bind 改用 service-token scopes），
# manage.token 属过时字段，本模板刻意不写 manage 段。
version: "4"

callback:
    url: "${YGG_PUBLIC_URL}"

core_api:
    base_url: "${HRPAUTH_URL}"
    # v14 凭据语义（两种用法，详见 .env.example）：当前 compose 默认注入
    # super 凭据，启动时经 POST /oauth/register 换取本服务低权限客户端
    # （client_id = presence 名 HRPAuth-Yggdrasil-API）；填低权限配对则
    # 幂等校验、不换取。容器内配置写回不持久化，每次启动重新换取，secret 稳定。
    client_id: "${YGG_CLIENT_ID}"
    client_secret: "${YGG_CLIENT_SECRET}"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    # YGG v4 起有独立端口字段：host 只放主机名/IP，端口走 port（与 HRPAuth 同理）。
    host: "${DB_HOST}"
    port: ${DB_PORT}
    password: "${DB_PASSWORD}"
    table_prefix: haygg_
    user: "${DB_USER}"

microservice:
    name: HRPAuth-Yggdrasil-API
    profile_cards:
        Minecraft Assets: 200
        Mojang Binding: 100
    relay_path_prefix: /yggdrasil-api
    relay_url: "${YGG_PUBLIC_URL}"
    ttl_seconds: 120

redis:
    db: ${REDIS_DB}
    host: "${REDIS_HOST}"
    password: "${REDIS_PASSWORD}"
    port: ${REDIS_PORT}
    prefix: hrpauth_ygg_

security:
    rate_limit_max_attempts: 10
    rate_limit_window_sec: 600

server:
    cors_origin: ""
    port: :2770

site:
    implementation: HRPAuth Yggdrasil API Provider
    name: HRPAuth
    version: 1.0.0

yggdrasil:
    feature_flags:
        enable_ip_check: false
        enable_mojang_anti_features: false
        enable_profile_key: false
        legacy_skin_api: true
        no_mojang_namespace: false
        non_email_login: true
        username_check: true
    security:
        max_texture_file_size: 512000
        max_texture_height: 1024
        max_texture_width: 1024
        max_tokens_per_user: 10
        session_expiry_seconds: 28800
        token_expiry_days: 15
    server:
        implementation: HRPAuth Yggdrasil API Provider
        links:
            homepage: ""
            register: ""
        name: HRPAuth
        signature_private_key_path: "${SIGNATURE_KEY_DIR}/private_key.pem"
        signature_public_key_path: "${SIGNATURE_KEY_DIR}/public_key.pem"
        skin_domains: []
        textures_storage: ./storage
        version: 1.0.0
