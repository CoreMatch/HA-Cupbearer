version: "2"

server:
    addr: ":2777"
    public_url: "${WINNERPROXY_PUBLIC_URL}"
    read_timeout_sec: 15
    write_timeout_sec: 15

log:
    level: info
    format: text

cache:
    size: 104857600
    ttl_sec: 300

hrpauth:
    url: "${HRPAUTH_URL}"
    # v14 凭据语义（填什么就按什么，运行时由服务自己判断，详见 .env.example）：
    # 1) 填 super 凭据 → 启动时经 POST /oauth/register 换取本服务低权限客户端
    #    （client_id = presence 名 WinnerProxy），super 凭据只用于换取那一次调用；
    # 2) 填本服务专用低权限对（如 hrpauth service_clients 种子的 WinnerProxy 行）→
    #    启动只做幂等校验（client_credentials 令牌请求），不发换取请求。
    # 容器部署注意：本文件是容器启动时由模板渲染的一次性配置，换取成功后的
    # 写回不会跨重启持久化，换取路径下每次启动都会重新换取——HRPAuth
    # get-or-create 保证每次拿到的 secret 稳定，无副作用；勿以为改容器内文件能保留。
    # 防呆：若把 super secret 填进这里，HRPAuth 种子会跳过本服务种子条目并告警，
    # 本服务走自助注册拿到独立 secret（见 .env.example）。
    client_id: "${WINNERPROXY_CLIENT_ID}"
    client_secret: "${WINNERPROXY_CLIENT_SECRET}"
    presence:
        enabled: true
        name: WinnerProxy
        ttl_seconds: 0
    sdk:
        enabled: true

upstreams:
    official:
        url: https://api.minecraftservices.com
        timeout_sec: 10
        enabled: true
    hrpauth:
        url: "${HRPAUTH_YGG_URL}"
        # 与上方 hrpauth 段同一对变量（compose 以 :? 必填注入）：v14 语义
        # "填什么就按什么"——填 super 凭据走启动换取，填专用低权限对走
        # 幂等校验（两种用法与容器写回说明见上方注释）。
        client_id: "${WINNERPROXY_CLIENT_ID}"
        client_secret: "${WINNERPROXY_CLIENT_SECRET}"
        timeout_sec: 10
        enabled: true

site:
    name: WinnerProxy
    # 加引号防坑：不带引号时靠"两个点不是数字"才被 YAML 解析成字符串。
    version: "0.2.0"
