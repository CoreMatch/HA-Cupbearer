version: "1.11.0"

server:
  host: "0.0.0.0"
  port: 9178
  read_timeout_seconds: 15
  write_timeout_seconds: 15

database:
  host: "${DB_HOST}"
  port: ${DB_PORT}
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
  max_open_conns: 50
  max_idle_conns: 10

redis:
  host: "${REDIS_HOST}"
  port: ${REDIS_PORT}
  password: "${REDIS_PASSWORD}"
  db: ${REDIS_DB}

# v1.1.0~v1.5.0 迁移新增的 auth 块（1.2.0 收敛为 base_url 单字段，
# 1.3.0 增加 public_client_id，1.4.0 增加 maintenance_token，
# 1.5.0 增加 service_client_id/service_client_secret 服务身份）。
auth:
  hrpauth:
    # HRPAuth 根地址；compose 网络内直连。
    base_url: "${HRPAUTH_URL}"
    # OAuth2 public client_id（第一方 refresh_token 流程），与 HRPAuth 对齐。
    public_client_id: "${HRPAUTH_PUBLIC_CLIENT_ID}"
    # 服务身份（config 1.5.0，client_credentials）：取 HRPAuth 内置 super
    # client 凭据，与 Yggdrasil-API 的 core_api.client_id/secret 同源；
    # 由 compose 以 ${VAR:?} 注入，缺值时容器直接启动失败。
    service_client_id: "${HRPAUTH_SUPER_CLIENT_ID}"
    service_client_secret: "${HRPAUTH_SUPER_CLIENT_SECRET}"
  # 运维超级凭据。代码迁移在缺失时会自动生成随机值，但容器内配置
  # 非持久，重启即变，故显式由 .env 注入（MCA_MAINTENANCE_TOKEN）。
  maintenance_token: "${MCA_MAINTENANCE_TOKEN}"

# 匹配系统（config 1.6.0+）：后台引擎周期性扫描队列、按分差窗口贪心成局。
# 参数与 MatchCoreArena-Server config.example.yaml 的默认值一致。
matchmaking:
  enabled: true
  # 引擎扫描周期（秒）
  tick_seconds: 1
  # 排队超时（秒）：超时未成局自动移出队列
  queue_timeout_seconds: 300
  # 基础分差窗口
  base_rating_window: 200
  # 窗口随等待时长的放宽速率（每分钟）
  rating_window_growth_per_minute: 100
  # 分差窗口上限
  max_rating_window: 1000
  # 可排队模式：match_type 与对应各队人数
  modes:
    - match_type: "1v1"
      team_sizes: [1, 1]
    - match_type: "2v2"
      team_sizes: [2, 2]
  # 成局分配有效期（秒，config 1.10.0+）：OPS 分配查询端点
  # GET /api/matchmaking/assignment/{uuid} 用；超过该 TTL 的成局视为失效。
  assignment_ttl_seconds: 1800
  # 房间预占 TTL（秒，config 1.11.0+）：成局时对房间预占的保留时长。
  room_reservation_ttl_seconds: 900
  # 子服→房间静态清单（config 1.11.0+，可选）：整体不配置 = 不启用房间层，
  # 保持 1.9.x 行为；显式空清单（servers: []）会被配置校验拒绝。
  # 启用后成局时对房间做预占，成局记录的 join_target 携带绑定子服的地址
  # （代理路由插件 VelocityGate 即按该地址把玩家送进对应子服）。
  # 填法示例（把整段取消注释并换成真实值；子服名/房间名不得重复，
  # host 必填、port 1-65535，每个子服至少一个房间，capacity 为正）：
  #
  # servers:
  #   - name: "bw-sub-1"                 # 子服名（成局记录与运维引用用）
  #     host: "game-sub-1.internal.example"   # 子服地址：只对代理可达，不暴露公网
  #     port: 25565
  #     rooms:
  #       - name: "bw-room-1"            # 房间名（子服内唯一）
  #         capacity: 8                  # 房间容量（正整数）
  #
  # 成局后下发给客户端的游戏服务器地址（交接链路用）。这是无房间层
  # （未配置 servers）时成局记录携带的全局地址；启用房间层后成局记录
  # 改携绑定子服的地址，本段仅在预占失效回落时使用。host 留空（默认）
  # 视为未配置：成局响应不携带该字段，客户端回落本地配置。
  # 由 .env 的 MCA_JOIN_TARGET_HOST / MCA_JOIN_TARGET_PORT 注入；
  # 接入 VelocityGate 且启用房间层时两者保持空/0 即可。
  join_target:
    host: "${MCA_JOIN_TARGET_HOST}"
    port: ${MCA_JOIN_TARGET_PORT}

# 排行榜展示配置（config 1.9.0+，纯展示：不参与结算、不引入赛季）。
# tiers 留空时前端不显示段位进度条；需要时按 config.example.yaml 填写。
ranking:
  tiers: []
