version: "7"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    # HASkinLib v7 起有独立端口字段：host 只放主机名/IP，端口走 port（与 HRPAuth/YGG 同理）。
    host: "${DB_HOST}"
    port: ${DB_PORT}
    password: "${DB_PASSWORD}"
    table_prefix: hasl_
    user: "${DB_USER}"

server:
    port: :2701
    # 代码默认 "*"（缺段时运行期同样兜底 "*"），显式写出。
    cors: "*"

# v4->v5 迁移新增段：HRPAuth 核心 API 客户端（运行时真实调用
# /internal/verify-token、/services/users/:uuid 等）。base_url 走 compose
# 网络直连（代码默认 http://127.0.0.1:2778 在容器内不可达，必须覆盖）。
# client_id/client_secret 对应 HRPAuth 启动时幂等种入的专用服务客户端
# （client_id 固定 haskinlib，见 HRPAuth controllers/startup_controller.go
# 默认配置生成器第 5 条种子）；.env 的 HASKINLIB_CLIENT_SECRET 必须与
# HRPAuth 渲染配置中该种子行的 secret 同值。HASkinLib 无 presence 登记、
# 不走 v14 自助换取，凭据单一来源直接注入（同 SDKHandler 模式）。
core_api:
    base_url: "${HRPAUTH_URL}"
    client_id: "${HASKINLIB_CLIENT_ID}"
    client_secret: "${HASKINLIB_CLIENT_SECRET}"

textures:
    max_request_bytes: 2359296
    max_upload_bytes: 2097152
    preview_storage_dir: ./data/previews
    rate_limit_per_minute: 5
    rate_limit_window_seconds: 60
    storage_dir: ./data/textures
