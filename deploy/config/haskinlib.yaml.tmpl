version: "6"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    host: "${DB_HOST}"
    password: "${DB_PASSWORD}"
    table_prefix: hasl_
    user: "${DB_USER}"

server:
    port: :2701

textures:
    max_request_bytes: 2359296
    max_upload_bytes: 2097152
    preview_storage_dir: ./data/previews
    rate_limit_per_minute: 5
    rate_limit_window_seconds: 60
    storage_dir: ./data/textures
