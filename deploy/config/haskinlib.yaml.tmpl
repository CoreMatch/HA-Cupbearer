version: "7"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    # HASkinLib v7 起有独立端口字段：host 只放主机名/IP，端口走 port（与 HRPAuth/YGG 同理）。
    host: "${DB_HOST}"
    port: ${DB_PORT}
    password: "${DB_PASSWORD}"
    table_prefix: hasl_
    user: "${DB_USER}"

server:
    port: :2701
    # 代码默认 "*"（缺段时运行期同样兜底 "*"），显式写出。
    cors: "*"

# v4->v5 迁移新增段：HRPAuth 核心 API 客户端（运行时真实调用
# /internal/verify-token、/services/users/:uuid 等）。base_url 走 compose
# 网络直连（代码默认 http://127.0.0.1:2778 在容器内不可达，必须覆盖）。
# client_id/client_secret 对应 HRPAuth 渲染配置 oauth2.service_clients 中
# 的 HASkinLib 种子行（hrpauth.yaml.tmpl，经 ensureConfiguredServiceClients
# 启动时幂等登记）；种子与本段消费同一对 .env 变量（HASKINLIB_CLIENT_ID/
# SECRET），天然同值。HASkinLib 无 presence 登记、不走 v14 自助换取，凭据
# 单一来源直接注入（同 SDKHandler 模式）。
core_api:
    base_url: "${HRPAUTH_URL}"
    client_id: "${HASKINLIB_CLIENT_ID}"
    client_secret: "${HASKINLIB_CLIENT_SECRET}"

textures:
    max_request_bytes: 2359296
    max_upload_bytes: 2097152
    preview_storage_dir: ./data/previews
    rate_limit_per_minute: 5
    rate_limit_window_seconds: 60
    storage_dir: ./data/textures
