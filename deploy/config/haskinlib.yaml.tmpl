version: "6"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    # HASkinLib 的 DatabaseConfig 没有端口字段（DSN 直接使用 host），
    # 端口以内嵌 "ip:port" 写法下发（与 HRPAuth/YGG 增加端口字段前的方案一致）。
    # 项目侧补端口字段后改回 host + port 两字段（见 DEPLOY-PROJECT-GAPS）。
    host: "${DB_HOST}:${DB_PORT}"
    password: "${DB_PASSWORD}"
    table_prefix: hasl_
    user: "${DB_USER}"

server:
    port: :2701

textures:
    max_request_bytes: 2359296
    max_upload_bytes: 2097152
    preview_storage_dir: ./data/previews
    rate_limit_per_minute: 5
    rate_limit_window_seconds: 60
    storage_dir: ./data/textures
