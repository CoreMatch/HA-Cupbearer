version: "14"

server:
    port: :2778
    cors_origin: "*"

database:
    charset: utf8mb4
    db_name: "${DB_NAME}"
    # HRPAuth v12 起有独立端口字段：host 只放主机名/IP，端口走 port。
    host: "${DB_HOST}"
    port: ${DB_PORT}
    password: "${DB_PASSWORD}"
    user: "${DB_USER}"
    # v11 新增（v10->v11 迁移项，此处取代码默认值）：
    # 连接失败后每隔 retry_interval_sec 秒重试，最多 max_retries 次；
    # 仍失败则等待 next_round_delay_min 分钟后开启下一轮（0 = 不再重试）。
    retry_interval_sec: 3
    max_retries: 5
    next_round_delay_min: 5

redis:
    db: ${REDIS_DB}
    host: "${REDIS_HOST}"
    password: "${REDIS_PASSWORD}"
    port: ${REDIS_PORT}
    prefix: hrpauth_

verification_code:
    code_ttl: 600
    storage_dir: ./cache/verification_codes

security:
    captcha_ttl: 300
    enable_captcha: true
    password_cost: 10
    rate_limit_max_attempts: 10
    rate_limit_window_sec: 600

smtp:
    encryption: tls
    from_email: "${SMTP_FROM_EMAIL}"
    from_name: HRPAuth
    host: "${SMTP_HOST}"
    password: "${SMTP_PASSWORD}"
    port: "${SMTP_PORT}"
    username: "${SMTP_USERNAME}"

callback:
    url: "${HRPAUTH_PUBLIC_URL}"

frontend:
    url: "${HRPAUTH_FRONTEND_URL}"

manage:
    token: "${MANAGE_TOKEN}"

oauth2:
    access_token_ttl_sec: 3600
    authorization_code_ttl_sec: 300
    issuer: "${HRPAUTH_PUBLIC_URL}"
    public_client_id: "${HRPAUTH_PUBLIC_CLIENT_ID}"
    public_redirect_uris:
        - ${HRPAUTH_PUBLIC_URL}/oauth/callback
    refresh_token_ttl_sec: 2592000
    super_client_id: "${HRPAUTH_SUPER_CLIENT_ID}"
    super_client_secret: "${HRPAUTH_SUPER_CLIENT_SECRET}"
    # v7 新增（v6->v7 迁移项）：超级客户端额外授权范围，默认空。
    super_client_extra_scopes: []
    # v13 新增（v12->v13 迁移项）：服务客户端种子列表。启动时幂等登记到
    # oauth2_clients（confidential / client_credentials / is_super=false）；
    # 已存在的行不会被覆盖（secret 漂移只告警，需人工对账）。
    # 每对的 client_id/client_secret 与对应服务自己配置中的凭据同源
    # （同一个 .env 变量），保证"种子里的 secret"与"服务拿来换令牌的
    # secret"永远一致。MCA 不在此列：它继续共用 super client（作者口径：
    # 开发环境共用即可）。
    # 命名约定：种子 client_id（取自 env）与各服务 presence 自报名逐字一致
    # （WinnerProxy / HRPAuth-Yggdrasil-API / HASkinProxy；SDKHandler 无 presence、
    # 不走自助，名字与 presence 无关）——因此 v14 自助注册 get-or-create
    # 直接命中种子行，不会新建第二行。旧名行（winnerproxy /
    # hrpauth-yggdrasil-api / yggdrasil-api / haskinproxy）不会自动改名，
    # 升级时需人工清掉旧行或忽略（不做自动迁移）。
    service_clients:
        - client_id: "${WINNERPROXY_CLIENT_ID}"
          client_secret: "${WINNERPROXY_CLIENT_SECRET}"
          name: WinnerProxy
        - client_id: "${YGG_CLIENT_ID}"
          client_secret: "${YGG_CLIENT_SECRET}"
          name: HRPAuth-Yggdrasil-API
        - client_id: "${HASKINPROXY_CLIENT_ID}"
          client_secret: "${HASKINPROXY_CLIENT_SECRET}"
          name: HASkinProxy
        - client_id: "${SDKHANDLER_CLIENT_ID}"
          client_secret: "${SDKHANDLER_CLIENT_SECRET}"
          name: HA-WebUI-SDKHandler
    # v14 新增（v13->v14 迁移项）：自助客户端注册（POST /oauth/register，
    # 仅内置 super client 可发起）的 scope 允许列表，键为服务 presence 名。
    # 键必须与 presence 名逐字一致：WinnerProxy / HASkinProxy 为各自模板
    # presence.name 默认名；HRPAuth-Yggdrasil-API 为 YGG 的 microservice.name
    # （presence 登记名；yggdrasil-api 只是它申请 scope 时用的名字，不是登记名）。
    # 实测结论：三个服务所需 scope 均为空（运维级检查只看"是否服务令牌"，
    # 不查 scope 列表），故全部给空列表。SDKHandler 不在列表内：它不能
    # 自助注册，仍由上方 service_clients 种子预置。
    service_scope_allowlist:
        WinnerProxy: []
        HRPAuth-Yggdrasil-API: []
        HASkinProxy: []

# v8 引入（v7->v8 迁移）：解耦后的 Yggdrasil-API 服务地址。
# 心跳等主程序 -> Yggdrasil-API 调用使用该地址；compose 网络内直连。
yggdrasil_api:
    base_url: "http://hrpauth-yggdrasil-api:2770"

# v9 新增（v8->v9 迁移项）：SDK 源码头包代理存储（供 HA-WebUI-SDKHandler 拉取）。
# 值取代码默认；目录位于 hrpauth-data 卷内（/app/data）。
sdk_packages:
    storage_dir: ./data/sdk_packages
    max_package_size: 20971520
    max_packages: 128

site:
    implementation: HRPAuth service
    name: HRPAuth
    version: "6"

# 注意：v6 模板中的 storage / keygen / yggdrasil 三个段已在 v7->v8 迁移中
# 移除，v11 代码不再解析它们（feature_flags、签名密钥路径等已迁出主服务配置），
# 因此此处不再保留。
